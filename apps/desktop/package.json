{
	"name": "devil-ai-desktop",
	"version": "1.13.0",
	"description": "Devil AI Desktop App",
	"author": "Devil-ai",
	"license": "MIT",
	"homepage": "https://github.com/devilbhai/devil-ai",
	"repository": {
		"type": "git",
		"url": "https://github.com/devilbhai/devil-ai.git",
		"directory": "apps/desktop"
	},
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"predev": "node scripts/kill-port.js 1420",
		"dev": "electron-vite dev",
		"dev:wayland": "electron-vite dev -- --ozone-platform=wayland --enable-features=WaylandWindowDecorations --disable-features=WaylandFractionalScaleV1",
		"dev:web": "vite --config src/renderer/vite.web.config.ts",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"package": "bun run build && electron-builder --config electron-builder.yml --publish always",
		"package:linux": "bun run build && electron-builder --linux --c.npmRebuild=false --config electron-builder.yml --publish always",
		"package:mac": "bun run build && electron-builder --mac --config electron-builder.yml --publish always",
		"package:mac:arm64": "bun run build && electron-builder --mac --arm64 --config electron-builder.yml --publish always",
		"package:mac:x64": "bun run build && electron-builder --mac --x64 --config electron-builder.yml --publish always",
		"package:win": "bun run build && electron-builder --win --c.npmRebuild=false --config electron-builder.yml --publish always",
		"package:all": "bun run build && electron-builder --linux --mac --win --c.npmRebuild=false --config electron-builder.yml --publish always",
		"eb:linux": "electron-builder --linux --c.npmRebuild=false --config electron-builder.yml --publish always",
		"eb:mac": "electron-builder --mac --config electron-builder.yml --publish always",
		"eb:win": "electron-builder --win --c.npmRebuild=false --config electron-builder.yml --publish always",
		"rebuild": "electron-rebuild",
		"lint": "biome check .",
		"check-types": "tsgo --noEmit",
		"clean": "rm -rf out release dist node_modules .turbo"
	},
	"dependencies": {
		"@devil-ai/agent-bridge": "workspace:*",
		"@devil-ai/configconv": "workspace:*",
		"@devil-ai/ui": "workspace:*",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@hello-pangea/dnd": "^18.0.1",
		"@libsql/client": "^0.17.0",
		"@devilcode/sdk": "workspace:*",
		"@pierre/diffs": "^1.0.10",
		"@tanstack/react-query": "^5.90.20",
		"@tanstack/react-router": "^1.158.4",
		"@tanstack/react-virtual": "^3.13.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/addon-webgl": "^0.19.0",
		"bonjour-service": "^1.3.0",
		"drizzle-orm": "1.0.0-rc.3",
		"electron-updater": "^6.7.3",
		"fuzzysort": "^3.1.0",
		"hono": "4.11.9",
		"jotai": "^2.17.1",
		"jotai-family": "^1.0.1",
		"lucide-react": "^1.28.0",
		"motion": "^12.34.0",
		"node-pty": "^1.1.0",
		"page-agent": "^1.12.2",
		"playwright": "^1.61.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.6.2",
		"react-syntax-highlighter": "^16.1.0",
		"reactflow": "^11.11.4",
		"remark-gfm": "^4.0.1",
		"rich-textarea": "^0.27.0",
		"rrule": "^2.8.1",
		"semver": "^7.7.4",
		"simple-git": "^3.30.0",
		"sonner": "^2.0.7",
		"tesseract.js": "^7.0.0",
		"xterm": "^5.3.0"
	},
	"optionalDependencies": {
		"electron-liquid-glass": "^1.1.1"
	},
	"devDependencies": {
		"@devil-ai/server": "workspace:*",
		"@electron/notarize": "^3.1.1",
		"@electron/rebuild": "^4.0.3",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/semver": "^7.7.1",
		"@vitejs/plugin-react": "^5.1.4",
		"drizzle-kit": "1.0.0-rc.3",
		"electron": "^43.2.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"kill-port": "^2.0.1",
		"node-abi": "^4.33.0",
		"shiki": "^3.22.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.0",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.2.0"
	}
}

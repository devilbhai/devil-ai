{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["**/AGENTS.local.md", "./.local/memory.md"],
	"references": {
		"osiris": {
			"repository": "simplifaisoul/osiris",
			"branch": "master",
			"description": "OSINT platform - Real-time global intelligence dashboard with flight tracking, CCTV, earthquakes, conflict zones, crypto wallet tracing, and OFAC sanctions search. Use for security research, intelligence gathering, and OSINT tasks."
		},
		"public-apis": {
			"repository": "public-apis/public-apis",
			"branch": "master",
			"description": "Curated list of 1400+ free public APIs across 50+ categories (Animals, Anime, Weather, Finance, Security, etc.). Use when needing to find or integrate external APIs for any project."
		},
		"claude-skills": {
			"repository": "ComposioHQ/awesome-claude-skills",
			"branch": "master",
			"description": "1000+ ready-made Claude Skills for document processing, development, business automation, security, creative tasks. Use to find pre-built skills for any workflow or automation task."
		}
	},

	"model": "ollama/qwen2.5-coder:3b",
	"provider": {
		"ollama": {
			"api": "ollama",
			"options": {
				"baseURL": "http://127.0.0.1:11434/api"
			},
			"models": {
				"qwen2.5-coder:3b": {
					"name": "qwen2.5-coder:3b",
					"tool_call": true
				}
			}
		},
		"google": {
			"api": "google",
			"options": {
				"apiKey": "${GOOGLE_API_KEY}"
			}
		},
		"groq": {
			"api": "openai",
			"options": {
				"apiKey": "${GROQ_API_KEY}",
				"baseURL": "https://api.groq.com/openai/v1"
			}
		},
		"privatemode-ai": {
			"api": "anthropic",
			"options": {
				"apiKey": "${AGENT_ROUTER_TOKEN}",
				"baseURL": "https://agentrouter.org/v1"
			},
			"models": {
				"gpt-5.5": {
					"name": "claude-opus-4-8",
					"tool_call": true,
					"attachment": true,
					"headers": {
						"User-Agent": "Cline/1.0.0",
						"X-Title": "Cline",
						"AGENT_ROUTER_TOKEN": "${AGENT_ROUTER_TOKEN}",
						"CODEX_MODEL": "claude-opus-4-8"
					}
				}
			}
		}
	},

{
	"name": "devil-ai-cli",
	"version": "0.14.0",
	"description": "AI-powered coding assistant via Telegram — CLI version of Devil AI",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"devil-ai": "./bin/devil-ai"
	},
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"check-types": "tsc --noEmit",
		"start": "node dist/cli.js",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"commander": "^13.1.0",
		"chalk": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"ai",
		"coding-assistant",
		"telegram-bot",
		"opencode",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/devilbhai/devil-ai-cli"
	}
}
